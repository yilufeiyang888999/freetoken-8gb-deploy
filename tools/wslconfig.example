# ==============================================================================
# WSL2 资源配置模板
# ------------------------------------------------------------------------------
# 使用方法：
#   1. 把本文件复制到 C:\Users\<你的Windows用户名>\.wslconfig（注意文件名前面有个点，没有扩展名）
#   2. 在 PowerShell 里执行：wsl --shutdown
#   3. 重新打开 WSL 终端生效
#
# 为什么需要它：
#   WSL2 默认只拿宿主内存的 50%，你 32GB 的笔记本会被限制在 16GB 左右。
#   而 Qwen3.6-35B-A3B 的 NVFP4 权重约 17.5GB，光靠默认值就装不下。
#   把上限提到 28GB，才够放专家池 + KV 缓存。
#
# 注意：本配置对整个 WSL2 生效，Docker Desktop 的发行版也受它影响。
#       跑 FreeToken 之前先退出 Docker Desktop，别让两边抢内存。
# ==============================================================================

[wsl2]

# 内存上限：物理内存 32GB，留 4GB 给 Windows 本体和桌面
memory=28GB

# 交换空间：突发内存峰值时的兜底，防止直接 OOM 杀进程
swap=8GB

# 交换文件位置
# 放在 Ubuntu 发行版同目录下（该目录已存在，无需新建）
#
# ⚠️ 取消下面这行的注释时，务必让 swapFile 顶格 —— 行首留一个空格，
#    WSL 会把键名解析成 " swapFile"（带空格），这一行就静默失效了，
#    不报错、但 swap 仍写在 C 盘。这个坑 2026-09-30 实际踩过一次。
#
# swapFile=D:\\<数据盘路径>\\wsl\\Ubuntu\\swap.vhdx

# 处理器核心数：不设置 = 使用全部核心
# MoE 的 CPU 卸载路径需要多核参与计算，建议保持默认，不要把核心数调小
# processors=12

[experimental]

# 空闲内存回收：WSL 用过的内存会逐步归还给 Windows
# 不开启的话，一旦 WSL 吃过 28GB，即使空闲也不会释放，Windows 会一直卡
autoMemoryReclaim=gradual

# 稀疏虚拟磁盘自动收缩，避免 ext4.vhdx 只涨不缩
sparseVhd=true
